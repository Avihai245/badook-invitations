{
  "id": "skate-graffiti",
  "version": 2,
  "name": {
    "he": "סקייטפארק",
    "en": "Skate Park"
  },
  "description": {
    "he": "העיר בין ערביים — קיר בטון עם התאריך בגרפיטי של אותיות בועה, טפטופי ספריי ותגיות, רמפה עם סקייטבורד באוויר, זוג סניקרס שתלוי על חוט החשמל ושמיים סגולים־כתומים. לבני ולבנות העשרה.",
    "en": "The city at dusk — a concrete wall with the date in graffiti bubble letters, spray drips and tags, a ramp with a skateboard in mid-air, sneakers hanging from the power line and a violet-orange sky. Made for teens."
  },
  "tier": "premium",
  "categories": [
    "bar_mitzvah",
    "bat_mitzvah",
    "birthday"
  ],
  "supportsLocales": [
    "he",
    "en"
  ],
  "previewImage": "/templates/skate-graffiti/preview.webp",
  "previewVideo": "/templates/skate-graffiti/preview.mp4",
  "tokens": {
    "palette": {
      "bg": "#17151C",
      "surface": "#221F2A",
      "ink": "#F4F1F8",
      "inkMuted": "#ADA6BC",
      "accent": "#C8F53C",
      "accentInk": "#17151C",
      "line": "#332E3E",
      "heroText": "#FFFFFF"
    },
    "editablePaletteKeys": [
      "accent"
    ],
    "radius": {
      "card": 18,
      "button": 999
    },
    "divider": "gradient_line"
  },
  "palettePresets": [
    {
      "id": "lime",
      "name": {
        "he": "ליים חשמלי",
        "en": "Electric lime"
      },
