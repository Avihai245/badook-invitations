  "cover": {
    "style": "envelope_seal",
    "renderer": "video",
    "poster": "/templates/skate-graffiti/cover-poster.webp",
    "posterDesktop": "/templates/skate-graffiti/cover-poster-desktop.webp",
    "openVideo": "/templates/skate-graffiti/cover-open.mp4",
    "openVideoDesktop": "/templates/skate-graffiti/cover-open-desktop.mp4",
    "holdMs": 500,
    "overlay": {
      "kind": "wax_seal",
      "image": "/templates/skate-graffiti/sticker-blank.png",
      "recolor": true,
      "size": 0.3,
      "offset": {
        "x": 0,
        "y": 0
