{
  "id": "grand-prix",
  "version": 2,
  "name": {
    "he": "מרוץ",
    "en": "Grand Prix"
  },
  "description": {
    "he": "יום מרוץ בשמש — רמזורי זינוק שנדלקים, דגלי משבצות שמתנופפים, מסלול מתעקל עם שוליים באדום־לבן, מכונית מרוץ שהגלגלים שלה מסתובבים ופודיום עם גביע. יום הולדת במהירות מלאה.",
    "en": "Race day in the sun — start lights glowing, checkered flags waving, a curving track with red-and-white kerbs, a race car with spinning wheels and a podium with a trophy. A birthday at full speed."
  },
  "tier": "standard",
  "categories": [
    "birthday",
    "bar_mitzvah"
  ],
  "supportsLocales": [
    "he",
    "en"
  ],
  "previewImage": "/templates/grand-prix/preview.webp",
  "previewVideo": "/templates/grand-prix/preview.mp4",
  "tokens": {
    "palette": {
      "bg": "#F4F6F9",
      "surface": "#FFFFFF",
      "ink": "#141A26",
      "inkMuted": "#566072",
      "accent": "#E10600",
      "accentInk": "#FFFFFF",
      "line": "#DCE1E8",
      "heroText": "#14213D"
    },
    "editablePaletteKeys": [
      "accent",
      "accentInk"
    ],
    "radius": {
      "card": 12,
      "button": 6
    },
    "divider": "gradient_line"
  },
  "palettePresets": [
