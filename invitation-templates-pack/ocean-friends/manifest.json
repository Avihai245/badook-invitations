{
  "id": "ocean-friends",
  "version": 2,
  "name": {
    "he": "מתחת לים",
    "en": "Ocean Friends"
  },
  "description": {
    "he": "צוללים לחגוג — לוויתן מחייך שנושף בועות, מדוזה מרחפת, דגים צבעוניים, אצות מתנועעות, צדפים, סרטן חמוד ותיבת אוצר נוצצת על החול. עולם תת־ימי לקטנטנים.",
    "en": "Dive in to celebrate — a smiling whale blowing bubbles, a floating jellyfish, colourful fish, swaying seaweed, shells, a friendly crab and a sparkling treasure chest on the sand. An undersea world for little ones."
  },
  "tier": "standard",
  "categories": [
    "birthday",
    "baby_shower",
    "brit"
  ],
  "supportsLocales": [
    "he",
    "en"
  ],
  "previewImage": "/templates/ocean-friends/preview.webp",
  "previewVideo": "/templates/ocean-friends/preview.mp4",
  "tokens": {
    "palette": {
      "bg": "#E8F6F6",
      "surface": "#FFFFFF",
      "ink": "#123A57",
      "inkMuted": "#46677C",
      "accent": "#FF7A6B",
      "accentInk": "#123A57",
      "line": "#CBE6E8",
      "heroText": "#123A57"
    },
    "editablePaletteKeys": [
      "accent",
      "accentInk"
    ],
    "radius": {
      "card": 26,
      "button": 999
    },
    "divider": "gradient_line"
  },
  "palettePresets": [
    {
      "id": "coral",
      "name": {
        "he": "אלמוג",
        "en": "Coral"
      },
      "palette": {
        "accent": "#FF7A6B",
        "accentInk": "#123A57"
      }
    },
    {
      "id": "sunny",
      "name": {
        "he": "דג זהב",
        "en": "Goldfish"
      },
      "palette": {
        "accent": "#F5B82E",
        "accentInk": "#123A57"
      }
    },
    {
      "id": "lilac",
      "name": {
        "he": "סגול",
        "en": "Lilac"
      },
      "palette": {
        "accent": "#7E5FD0",
        "accentInk": "#FFFFFF"
      }
    }
  ],
  "fontPairs": [
