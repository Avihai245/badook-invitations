            "x": 0.5,
            "y": 0.5
          }
        }
      }
    ],
    "textColor": "#FBF3E4",
    "overlayColor": "#08231F",
    "defaultOverlay": 0.3
  },
  "music": {
    "defaultTrackId": "marrakech-theme",
