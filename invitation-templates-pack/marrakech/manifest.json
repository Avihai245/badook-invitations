{
  "id": "marrakech",
  "version": 2,
  "name": {
    "he": "מרקש",
    "en": "Marrakech Henna"
  },
  "description": {
    "he": "ליל חינה מרוקאי — קשת בצורת חור מנעול, כוכב זליג׳ בן שמונה קצוות, חמסה מנוקדת, פנסי נחושת מחוררים ורימונים, על ירוק אמרלד וזהב.",
    "en": "A Moroccan henna night — a keyhole arch, an eight-point zellige star, a dotted hamsa, pierced brass lanterns and pomegranates on emerald and gold."
  },
  "tier": "premium",
  "categories": [
    "henna",
    "engagement"
  ],
  "supportsLocales": [
    "he",
    "en"
  ],
  "previewImage": "/templates/marrakech/preview.webp",
  "previewVideo": "/templates/marrakech/preview.mp4",
  "tokens": {
    "palette": {
      "bg": "#FBF3E4",
      "surface": "#F4E8D2",
      "ink": "#2A1A14",
      "inkMuted": "#735A48",
      "accent": "#D4A640",
      "accentInk": "#2A1A14",
      "line": "#E6D3B0",
      "heroText": "#FBF3E4"
    },
    "editablePaletteKeys": [
      "accent",
      "accentInk"
    ],
    "radius": {
      "card": 16,
      "button": 6
    },
    "divider": "gradient_line"
  },
  "palettePresets": [
    {
      "id": "gold",
      "name": {
        "he": "זהב",
        "en": "Gold"
      },
      "palette": {
