  "assets": {
    "hero": "/templates/marrakech/hero.mp4",
    "hero-poster": "/templates/marrakech/hero-poster.webp",
    "hero-desktop": "/templates/marrakech/hero-desktop.mp4",
    "hero-desktop-poster": "/templates/marrakech/hero-desktop-poster.webp",
