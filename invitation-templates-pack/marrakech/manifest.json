  "cover": {
    "style": "gatefold",
    "renderer": "video",
    "poster": "/templates/marrakech/cover-poster.webp",
    "posterDesktop": "/templates/marrakech/cover-poster-desktop.webp",
    "openVideo": "/templates/marrakech/cover-open.mp4",
    "openVideoDesktop": "/templates/marrakech/cover-open-desktop.mp4",
    "holdMs": 500,
    "overlay": {
      "kind": "medallion",
      "image": "/templates/marrakech/medallion-blank.png",
      "recolor": true,
      "size": 0.3,
      "offset": {
        "x": 0,
        "y": 0
      },
      "exit": "lift",
