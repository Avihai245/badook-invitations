{
  "id": "caesarea-shore",
  "version": 2,
  "name": {
    "he": "חוף קיסריה",
    "en": "Caesarea Shore"
  },
  "description": {
    "he": "מעטפת פשתן בגוון חול עם חותם שעווה טורקיז, קשתות אמת המים בשעת הזהב וגלים רכים. ים־תיכוני, אוורירי ואלגנטי.",
    "en": "A sand-linen envelope with a teal wax seal, ancient aqueduct arches at golden hour and soft rolling waves. Mediterranean, airy and elegant."
  },
  "categories": [
    "wedding",
    "engagement",
    "save_the_date"
  ],
  "supportsLocales": [
    "he",
    "en"
  ],
  "previewImage": "/templates/caesarea-shore/preview.webp",
