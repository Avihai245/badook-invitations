      "ink": "#3B2618",
      "inkMuted": "#6E5746",
      "accent": "#7FAAD4",
      "accentInk": "#3B2618",
      "line": "#E2D2BC",
      "heroText": "#3B2618"
    },
    "editablePaletteKeys": [
      "accent"
