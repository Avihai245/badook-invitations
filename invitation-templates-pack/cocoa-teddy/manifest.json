      "text": {
        "color": "#3B2618",
        "effect": "print",
        "maxGlyphs": 6
      }
    },
    "sealColors": [],
    "monogramFont": {
      "latin": "Quicksand",
      "hebrew": "Varela Round"
    }
  },
  "hero": {
    "options": [
      {
        "id": "default",
        "name": {
          "he": "חדר תינוקות רך",
          "en": "A soft nursery"
        },
        "media": {
          "kind": "video",
          "src": "template:hero",
          "poster": "template:hero-poster",
          "focalPoint": {
            "x": 0.5,
            "y": 0.5
          }
        },
        "mediaDesktop": {
          "kind": "video",
          "src": "template:hero-desktop",
          "poster": "template:hero-desktop-poster",
          "focalPoint": {
            "x": 0.5,
            "y": 0.5
          }
        }
      }
    ],
    "textColor": "#3B2618",
    "overlayColor": "#FFFDF8",
    "defaultOverlay": 0.35
  },
  "music": {
    "defaultTrackId": "cocoa-teddy-theme",
    "tracks": [
      {
        "id": "cocoa-teddy-theme",
        "title": "Lullaby Bear (music box & glockenspiel)",
        "url": "/templates/cocoa-teddy/music.mp3",
        "license": "TBD — must be royalty-free for commercial use"
      }
    ]
  },
  "motion": {
    "preset": "soft",
    "revealDistance": 40,
    "revealBlur": true,
    "stagger": 0.08
  },
  "assets": {
    "hero": "/templates/cocoa-teddy/hero.mp4",
    "hero-poster": "/templates/cocoa-teddy/hero-poster.webp",
    "hero-desktop": "/templates/cocoa-teddy/hero-desktop.mp4",
    "hero-desktop-poster": "/templates/cocoa-teddy/hero-desktop-poster.webp",
    "gingham-band": "/templates/cocoa-teddy/gingham-band.webp",
    "clouds-panorama": "/templates/cocoa-teddy/clouds-panorama.webp",
    "teddy": "/templates/cocoa-teddy/teddy.webp",
    "bow": "/templates/cocoa-teddy/bow.webp",
    "teddy-face": "/templates/cocoa-teddy/teddy-face.webp"
  },
  "decorations": {
    "afterHero": "template:gingham-band",
    "betweenVenues": "template:clouds-panorama",
    "afterTimeline": "template:teddy",
    "beforeRsvp": "template:bow",
    "footer": "template:teddy-face"
  },
  "sectionDefaults": {
    "order": [
      "hero",
