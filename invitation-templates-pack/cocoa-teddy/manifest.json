{
  "id": "cocoa-teddy",
  "version": 2,
  "name": {
    "he": "דובון",
    "en": "Cocoa Teddy"
  },
  "description": {
    "he": "דובון בצבע שוקולד על משבצות גינגהם בתכלת אבקתי — פפיונים, עננים תפוחים ותפר רקמה מסביב. רך, מתוק ומחבק.",
    "en": "A chocolate teddy on powder-blue gingham — bows, puffy clouds and a running-stitch border. Soft, sweet and cuddly."
  },
  "tier": "standard",
  "categories": [
    "brit",
    "baby_shower",
    "birthday"
  ],
  "supportsLocales": [
    "he",
    "en"
  ],
  "previewImage": "/templates/cocoa-teddy/preview.webp",
  "previewVideo": "/templates/cocoa-teddy/preview.mp4",
  "tokens": {
    "palette": {
      "bg": "#F1E6D6",
