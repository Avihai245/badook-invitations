  "cover": {
    "style": "swaddle",
    "renderer": "video",
    "poster": "/templates/cocoa-teddy/cover-poster.webp",
    "posterDesktop": "/templates/cocoa-teddy/cover-poster-desktop.webp",
    "openVideo": "/templates/cocoa-teddy/cover-open.mp4",
    "openVideoDesktop": "/templates/cocoa-teddy/cover-open-desktop.mp4",
    "holdMs": 500,
    "overlay": {
      "kind": "tag",
      "image": "/templates/cocoa-teddy/tag-blank.png",
      "recolor": false,
      "size": 0.24,
