  },
  "decorations": {
    "afterHero": "template:tallit-stripes",
    "betweenVenues": "template:stone-arch",
    "afterTimeline": null,
    "beforeRsvp": "template:pomegranates",
    "footer": "template:torah-crown"
  },
  "sectionDefaults": {
    "order": [
      "hero",
      "countdown",
      "text",
      "venues",
      "timeline",
