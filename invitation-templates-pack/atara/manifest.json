{
  "id": "atara",
  "version": 2,
  "name": {
    "he": "עטרה",
    "en": "Atara"
  },
  "description": {
    "he": "שקית טלית מקטיפה רקומה בחוטי כסף שנפתחת אל ספר תורה באור חלון. לבר ולבת מצווה — מכובד, מרגש ונקי.",
    "en": "An embroidered velvet tallit bag that opens onto a Torah scroll in soft window light. For bar & bat mitzvah — dignified, moving and clean."
  },
  "categories": [
    "bar_mitzvah",
    "bat_mitzvah"
  ],
  "supportsLocales": [
    "he",
    "en"
  ],
  "previewImage": "/templates/atara/preview.webp",
  "previewVideo": "/templates/atara/preview.mp4",
  "tokens": {
    "palette": {
      "bg": "#F5F7FA",
      "surface": "#E8EDF4",
      "ink": "#14233F",
      "inkMuted": "#4E5B73",
      "accent": "#1F3A68",
      "accentInk": "#FFFFFF",
      "line": "#C8D2E2",
      "heroText": "#FFFFFF"
    },
    "editablePaletteKeys": [
      "bg",
      "surface",
      "ink",
      "inkMuted",
      "accent",
      "line"
    ],
    "radius": {
      "card": 16,
      "button": 6
    },
    "divider": "gradient_line"
  },
  "palettePresets": [
    {
      "id": "bar-navy",
      "name": {
        "he": "בר מצווה — כחול וכסף",
