{
  "id": "dig-it",
  "version": 2,
  "name": {
    "he": "חופרים!",
    "en": "Dig It!"
  },
  "description": {
    "he": "אתר בנייה לפעוטות — מחפר שמרים דלי מלא, משאית עם פרצוף מחייך, מנוף ששלט ״אזור עבודה״ עם התאריך מתנדנד עליו, קונוסים, ערימות חול וסרט אזהרה. יום הולדת עם קסדות!",
    "en": "A building site for toddlers — an excavator lifting a full bucket, a smiling dump truck, a crane swinging a “work zone” sign with the date, cones, dirt piles and caution tape. A birthday in hard hats!"
  },
  "tier": "standard",
  "categories": [
    "birthday"
  ],
  "supportsLocales": [
    "he",
    "en"
  ],
  "previewImage": "/templates/dig-it/preview.webp",
  "previewVideo": "/templates/dig-it/preview.mp4",
  "tokens": {
    "palette": {
      "bg": "#F8F1E1",
      "surface": "#FFFDF7",
      "ink": "#26221C",
      "inkMuted": "#5E564A",
      "accent": "#FFC20E",
      "accentInk": "#26221C",
      "line": "#E6DAC0",
      "heroText": "#26221C"
    },
    "editablePaletteKeys": [
      "accent",
      "accentInk"
    ],
    "radius": {
      "card": 14,
      "button": 10
    },
    "divider": "gradient_line"
  },
  "palettePresets": [
    {
      "id": "digger",
      "name": {
        "he": "צהוב מחפר",
        "en": "Digger yellow"
      },
      "palette": {
        "accent": "#FFC20E",
        "accentInk": "#26221C"
      }
    },
    {
      "id": "fire-truck",
      "name": {
        "he": "אדום",
        "en": "Fire-truck red"
      },
      "palette": {
        "accent": "#D93A26",
        "accentInk": "#FFFFFF"
      }
    },
    {
      "id": "tractor",
      "name": {
        "he": "כחול",
        "en": "Tractor blue"
      },
      "palette": {
        "accent": "#2A72C8",
        "accentInk": "#FFFFFF"
      }
    }
  ],
  "fontPairs": [
    {
      "id": "machine",
      "display": {
        "latin": "Unbounded",
        "hebrew": "Secular One"
      },
      "heading": {
        "latin": "Nunito",
        "hebrew": "Rubik"
      },
      "body": {
        "latin": "Nunito",
        "hebrew": "Rubik"
      },
      "ui": {
        "latin": "Nunito",
        "hebrew": "Rubik"
      }
    },
    {
      "id": "road-sign",
      "display": {
        "latin": "Big Shoulders Display",
        "hebrew": "Karantina"
      },
      "heading": {
        "latin": "Oswald",
        "hebrew": "Heebo"
      },
      "body": {
        "latin": "Inter",
        "hebrew": "Heebo"
      },
      "ui": {
        "latin": "Inter",
        "hebrew": "Heebo"
      }
    }
  ],
  "cover": {
    "style": "ticket",
    "renderer": "video",
    "poster": "/templates/dig-it/cover-poster.webp",
    "posterDesktop": "/templates/dig-it/cover-poster-desktop.webp",
    "openVideo": "/templates/dig-it/cover-open.mp4",
    "openVideoDesktop": "/templates/dig-it/cover-open-desktop.mp4",
    "holdMs": 500,
    "overlay": {
      "kind": "ticket_text",
      "image": null,
      "recolor": false,
      "size": 0.5,
      "offset": {
        "x": 0,
        "y": 0
      },
      "exit": "fade",
      "text": {
        "color": "#26221C",
        "effect": "print",
        "maxGlyphs": 12
      }
    },
    "sealColors": [],
    "monogramFont": {
      "latin": "Unbounded",
      "hebrew": "Secular One"
    }
  },
  "hero": {
    "options": [
      {
        "id": "default",
        "name": {
          "he": "אתר בנייה שמח",
          "en": "A happy building site"
        },
        "media": {
          "kind": "video",
          "src": "template:hero",
          "poster": "template:hero-poster",
          "focalPoint": {
            "x": 0.5,
            "y": 0.5
          }
        },
        "mediaDesktop": {
          "kind": "video",
          "src": "template:hero-desktop",
          "poster": "template:hero-desktop-poster",
          "focalPoint": {
            "x": 0.5,
            "y": 0.5
          }
        }
      }
    ],
    "textColor": "#26221C",
    "overlayColor": "#FFFBF0",
    "defaultOverlay": 0.35
  },
  "music": {
    "defaultTrackId": "dig-it-theme",
    "tracks": [
      {
        "id": "dig-it-theme",
        "title": "Busy Builders (ukulele, claps & toy horns)",
        "url": "/templates/dig-it/music.mp3",
        "license": "TBD — must be royalty-free for commercial use"
      }
    ]
  },
  "motion": {
    "preset": "soft",
    "revealDistance": 50,
    "revealBlur": false,
    "stagger": 0.06
  },
  "assets": {
    "hero": "/templates/dig-it/hero.mp4",
    "hero-poster": "/templates/dig-it/hero-poster.webp",
    "hero-desktop": "/templates/dig-it/hero-desktop.mp4",
    "hero-desktop-poster": "/templates/dig-it/hero-desktop-poster.webp",
    "caution-band": "/templates/dig-it/caution-band.webp",
    "site-panorama": "/templates/dig-it/site-panorama.webp",
    "excavator": "/templates/dig-it/excavator.webp",
    "cone": "/templates/dig-it/cone.webp",
    "hard-hat": "/templates/dig-it/hard-hat.webp"
  },
  "decorations": {
    "afterHero": "template:caution-band",
    "betweenVenues": "template:site-panorama",
    "afterTimeline": "template:excavator",
    "beforeRsvp": "template:cone",
    "footer": "template:hard-hat"
  },
  "sectionDefaults": {
    "order": [
      "hero",
      "countdown",
      "text",
      "venues",
      "timeline",
      "gallery",
      "faq",
      "gifts",
      "rsvp",
      "footer"
    ],
    "variants": {
      "timeline": "horizontal-icons",
      "venues": "stacked-with-map",
      "countdown": "boxes"
    }
  }
}
