{
  "id": "unicorn-dream",
  "version": 2,
  "name": {
    "he": "חד־קרן",
    "en": "Unicorn Dream"
  },
  "description": {
    "he": "שמיים בצבעי סוכריות — קשת בענן פסטלית, עננים רכים, נצנצים וכוכבים, בלונים ולבבות, וחד־קרן עם רעמה בכל צבעי הקשת וקרן זהב נוצצת. קסם ורוד ומתוק.",
    "en": "A candy-coloured sky — a pastel rainbow, soft clouds, sparkles and stars, balloons and hearts, and a unicorn with a rainbow mane and a glittering golden horn. Sweet pink magic."
  },
  "tier": "premium",
  "categories": [
    "birthday",
    "bat_mitzvah"
  ],
  "supportsLocales": [
    "he",
    "en"
  ],
  "previewImage": "/templates/unicorn-dream/preview.webp",
  "previewVideo": "/templates/unicorn-dream/preview.mp4",
  "tokens": {
