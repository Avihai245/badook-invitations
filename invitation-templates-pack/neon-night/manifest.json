      "ink": "#FFFFFF",
      "inkMuted": "#A9A3C9",
      "accent": "#FF2BD6",
      "accentInk": "#0B0A12",
      "line": "#2A2548",
      "heroText": "#FFFFFF"
    },
    "editablePaletteKeys": [
