      "hebrew": "Rubik"
    }
  },
  "hero": {
    "options": [
      {
        "id": "default",
        "name": {
          "he": "מועדון מואר בניאון",
          "en": "A club lit in neon"
        },
        "media": {
          "kind": "video",
          "src": "template:hero",
          "poster": "template:hero-poster",
          "focalPoint": {
            "x": 0.5,
            "y": 0.5
