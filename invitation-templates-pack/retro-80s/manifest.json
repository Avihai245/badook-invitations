{
  "id": "retro-80s",
  "version": 2,
  "name": {
    "he": "שנות ה־80",
    "en": "Retro 80s"
  },
  "description": {
    "he": "שקיעת סינת׳ווייב — שמש עם פסים ששוקעת מאחורי הרים עם קו ורוד, רשת זוהרת עד האופק, דקלים בצללית, קלטת שהסלילים שלה מסתובבים, נצנוצי כרום ושמיים מלאי כוכבים. כל הנוסטלגיה של שנות השמונים.",
    "en": "A synthwave sunset — a striped sun sinking behind pink-rimmed mountains, a glowing grid to the horizon, palm silhouettes, a cassette whose reels turn, chrome sparkles and a sky full of stars. All the nostalgia of the eighties."
  },
  "tier": "premium",
  "categories": [
    "birthday",
    "corporate",
    "other"
  ],
  "supportsLocales": [
    "he",
    "en"
  ],
  "previewImage": "/templates/retro-80s/preview.webp",
  "previewVideo": "/templates/retro-80s/preview.mp4",
  "tokens": {
    "palette": {
      "bg": "#150A2E",
      "surface": "#22123F",
      "ink": "#FDF3FF",
      "inkMuted": "#BCA8E4",
      "accent": "#FF4FA3",
      "accentInk": "#150A2E",
      "line": "#36205E",
      "heroText": "#FFFFFF"
    },
    "editablePaletteKeys": [
      "accent",
      "accentInk"
    ],
    "radius": {
      "card": 14,
      "button": 999
    },
    "divider": "gradient_line"
  },
  "palettePresets": [
    {
      "id": "hot-pink",
      "name": {
        "he": "ורוד לוהט",
