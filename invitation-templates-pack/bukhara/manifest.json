{
  "id": "bukhara",
  "version": 2,
  "name": {
    "he": "משי בוכרה",
    "en": "Bukhara Silk"
  },
  "description": {
    "he": "איקט ורקמת סוזאני בצבעים עזים — פסי מעוינים בקצוות מטושטשים, רוזטות רקומות, ענפי צבעונים, תפר שרשרת וגדילים משתלשלים.",
    "en": "Bold ikat and suzani embroidery — feathered lozenge bands, stitched rosettes, tulip sprigs, chain-stitch borders and swinging tassels."
  },
  "tier": "premium",
  "categories": [
    "henna",
    "engagement",
    "wedding"
  ],
  "supportsLocales": [
    "he",
    "en"
  ],
  "previewImage": "/templates/bukhara/preview.webp",
