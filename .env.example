# ─────────────────────────────────────────────────────────────────────────────
# Badook Invitations — environment variables
#
# Local dev: copy to .env.local and fill in.
# AWS Amplify: set these in the console (App settings → Environment variables),
# with branch overrides for `main` (production) and `dev` (preview).
# amplify.yml copies every var matching ^(NEXT_PUBLIC_|SUPABASE_|INVITES_) (and ANTHROPIC_API_KEY,
# OPENAI_API_KEY) into .env.production at build time so the SSR runtime can read them — so every
# variable the app uses MUST start with one of those prefixes.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (P1) ────────────────────────────────────────────────────────────
# Project URL, e.g. https://<ref>.supabase.co — different project per branch.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…). SERVER ONLY — RSVP writes, publish, signed uploads.
# Never prefix with NEXT_PUBLIC_, never import from client code.
SUPABASE_SECRET_KEY=

# ── Invitations feature ──────────────────────────────────────────────────────
# Public origin used for share links, OG images and ICS UIDs (no trailing slash).
# main: https://<your production domain>   dev: https://dev.<appid>.amplifyapp.com
INVITES_PUBLIC_BASE_URL=http://localhost:3000
# Brand shown in the invitation footer credit ("Made with love by {brand}") and OG image.
INVITES_BRAND_NAME=Badook
# Support contact shown to hosts.
INVITES_SUPPORT_EMAIL=
# Salt for hashing guest IPs (RSVP rate limiting). Random, ≥32 chars, different per branch.
INVITES_IP_HASH_SALT=
# Replies to the site's sample invitations (the demos visitors try) are checked but never kept.
# "store" keeps them like any other reply — only for the end-to-end tests, which read them back.
INVITES_DEMO_RSVP=
# Feature flag `invitations` — set to "false" to ship the feature dark (public + host routes 404).
INVITES_FEATURE_ENABLED=true
# Expose the dev-only kitchen sink (/dev/invitations, /dev/app-ui) in production builds.
# "true" on the dev branch only. Always on under `next dev`.
INVITES_DEV_ROUTES=false

# ── Optional ────────────────────────────────────────────────────────────────
# Cloudflare Turnstile on the RSVP form (both empty = disabled).
INVITES_TURNSTILE_SITE_KEY=
INVITES_TURNSTILE_SECRET_KEY=
# Base URL for template media (videos, music, posters). Defaults to the
# `template-media` public bucket of NEXT_PUBLIC_SUPABASE_URL; set it to reuse
# another project's bucket (e.g. dev pointing at production media).
NEXT_PUBLIC_TEMPLATE_MEDIA_BASE_URL=

# ── Host notifications (P4) ─────────────────────────────────────────────────
# Emails to the host about RSVPs (per reply, or a daily summary — chosen per invitation on the
# responses dashboard), sent through Resend (https://resend.com): an API key and a sender on a
# verified domain, e.g. "Badook <rsvp@badook.co.il>". Both empty = emails are only logged.
INVITES_EMAIL_API_KEY=
INVITES_EMAIL_FROM=
# The recurring jobs (the WhatsApp queue every couple of minutes; once a day at 06:00 UTC the RSVP
# summaries, the purge, the billing checks and the templates sync) run by themselves on the site's own
# traffic. A scheduler can call them as well: POST /api/cron/whatsapp and /api/cron/rsvp-digest with
# this bearer token (random, ≥32 chars) — .github/workflows/*.yml do, given the repository secrets
# INVITES_CRON_URL (the site) and INVITES_CRON_SECRET (this value). Empty = those endpoints are off.
INVITES_CRON_SECRET=
# off = the jobs run only when a scheduler calls them (default on)
INVITES_JOBS_FALLBACK=
# Emails with the top plan and the admin tools, comma-separated (the platform's owners).
INVITES_ADMIN_EMAILS=

# ── AI: the support assistant (the chat in the signed-in app) and the invitations' machine translation
# (feature translate_ai, reviewed by the host before publishing) ─────────────
# Anthropic API key (console.anthropic.com → API keys). Empty = the chat answers from the built-in
# guide by keywords and there is no machine translation (hosts translate by hand in the review
# screen). Note: this name has no INVITES_ prefix; amplify.yml copies it explicitly.
ANTHROPIC_API_KEY=
# The model's id, from Anthropic's models page (a smaller model costs less per question). Both this and
# the key are needed for AI answers and for the machine translation.
INVITES_AI_MODEL=
# Questions a day for the whole site, a cost ceiling (default 2000); past it the guide answers.
INVITES_AI_DAILY_LIMIT=
# "Design it for me" (feature art_direction) uses the same key and model: concepts made by the AI a day
# per account (default 12); past it — or without the AI — they are composed from the photos.
INVITES_ART_DIRECTION_DAILY_LIMIT=
# Event planning (feature planning_ai, Pro): a plan drafted from a description of an event, and a card's
# "summarize and suggest steps" — same key and model; drafts made by the AI a day per account (default 10).
INVITES_PLANNING_AI_DAILY_LIMIT=
# "Quick create with AI" (the gallery's short questionnaire) uses the same key and model too: up to 60
# answers an hour and 120 a day per account, within the site's ceiling above; past them — or without the
# AI — the app asks the same questions one by one itself.
# OpenAI instead of Anthropic, for the support chat and "quick create with AI": with this key the chat
# answers through OpenAI, and so does the questionnaire when there is no Anthropic key above.
# Translation, "design it for me", planning and the gallery check stay on the Anthropic key regardless.
OPENAI_API_KEY=
# The OpenAI model's id (platform.openai.com → the account's Models). Empty = gpt-5-mini.
INVITES_AI_MODEL_OPENAI=
# ── AI photos with the people of honor (feature ai_photos, docs/album-and-ai-photos.md) ──
# On only with OPENAI_API_KEY above. The GPT Image model (default gpt-image-2; a newer one, e.g. a
# gpt-image-2.5 model, by its exact id from the account's Models page — no code change).
INVITES_AI_IMAGE_MODEL=
# low | medium | high (default medium): each photo's price and time grow with it.
INVITES_AI_IMAGE_QUALITY=
# How the server asks for a photo: auto (default: OpenAI's background mode, else the Images API),
# background (started at once and checked with short requests — for hosts that cut requests at ~30 s,
# like Amplify), images (one request that waits for the photo, 20–90 s).
INVITES_AI_IMAGE_TRANSPORT=
# The text model that hands the request to the image tool in background mode (default gpt-5).
INVITES_AI_IMAGE_MAINLINE_MODEL=
# Photos a day for the whole site (a cost ceiling, default 1000); per guest and per event: the host's
# settings, within src/features/ai-photos/config.ts.
INVITES_AI_IMAGE_DAILY_LIMIT=

# ── The invitation read aloud (feature voice): Azure AI Speech, text to speech ──
# A Speech resource's key and its region (Azure portal → the resource → Keys and Endpoint), in the
# European Union (e.g. westeurope) as the privacy policy says. Empty = the guest's own device reads
# the invitation when it has a voice for the language. The voices per language: src/features/voice/config.ts.
INVITES_TTS_AZURE_KEY=
INVITES_TTS_AZURE_REGION=
# Another address for the service (the tests' stand-in); empty = the region's.
INVITES_TTS_AZURE_ENDPOINT=

# ── WhatsApp Business Platform (the system's official number) — docs/whatsapp-setup.md ──
INVITES_WHATSAPP_TOKEN=
INVITES_WHATSAPP_PHONE_NUMBER_ID=
INVITES_WHATSAPP_APP_SECRET=
INVITES_WHATSAPP_VERIFY_TOKEN=
# The approved message template (default badook_invitation).
INVITES_WHATSAPP_TEMPLATE=
# The languages Meta approved the templates in, as Meta's codes, comma-separated (default he,en; e.g.
# he,en,ru,ar,fr,es — Meta has no Amharic templates): the invitation's, the table number's and the
# gallery link's alike. Each guest gets a message in their language when it's here, else in the
# invitation's. docs/whatsapp-setup.md has the text for each language (sections 2א, 8 and 9).
INVITES_WHATSAPP_TEMPLATE_LANGS=
# Older single-language setting: used only when INVITES_WHATSAPP_TEMPLATE_LANGS is empty.
INVITES_WHATSAPP_TEMPLATE_LANG=
# The table number's template (each guest's table and a link to the map to it), e.g. badook_table — set
# it once Meta approved it; empty = hosts send table numbers from their own WhatsApp and printed cards.
INVITES_WHATSAPP_TABLE_TEMPLATE=
# The gallery link's template (each guest's link to the event's live gallery, to upload photos and see
# the album), e.g. badook_gallery — set it once Meta approved it (docs/whatsapp-setup.md §9); empty =
# hosts send the gallery link from their own WhatsApp or copy a ready message with it.
INVITES_WHATSAPP_GALLERY_TEMPLATE=
# The album's thank-you template ("thank you for celebrating with us" and a button to the album), e.g.
# badook_album — set it once Meta approved it (docs/whatsapp-setup.md §10); empty = hosts send the
# thank-you from their own WhatsApp or copy a ready message with the album's link.
INVITES_WHATSAPP_ALBUM_TEMPLATE=
# Meta's marketing-message rate for Israel in USD (default 0.0353) and the shekel rate (default 3.7).
INVITES_WHATSAPP_PRICE_USD=
INVITES_USD_TO_ILS=

# ── Payments: Tranzila — docs/billing-setup.md ─────────────────────────────
# With the API keys set (here, or in the Supabase Vault as TRANZILA_API_APP_KEY / TRANZILA_API_SECRET),
# purchases go through Tranzila: its card form in an iframe holds the sum and our server takes it (the iframe
# terminal); every month the server charges the card's token (the token terminal).
# The terminals' names (defaults badookinvit and badookinvittok).
INVITES_TRANZILA_TERMINAL=
INVITES_TRANZILA_TOKEN_TERMINAL=
# The API keys (Tranzila → settings → API): the app key (public) and the secret (private).
INVITES_TRANZILA_APP_KEY=
INVITES_TRANZILA_SECRET=
# What the iframe does with the card: VK (default: holds the sum, which the server then takes), NK, K.
INVITES_TRANZILA_TRANMODE=
# The iframe terminal's TranzilaPW (optional): locks the form's sum in advance (handshake).
INVITES_TRANZILA_PW=
# Apple Pay / Google Pay buttons in the form (1 to show them): only after Tranzila turns them on for the
# iframe terminal (and, for Apple Pay, registers our domain).
INVITES_TRANZILA_APPLE_PAY=
INVITES_TRANZILA_GOOGLE_PAY=
# Apple Pay's domain file, if Tranzila gives one (empty: Tranzila's public copy is served).
INVITES_TRANZILA_APPLE_PAY_FILE=

# ── Payments: PayPlus — docs/billing-setup.md ───────────────────────────────
# Used when Tranzila's keys aren't set (and for plans already paying through PayPlus).
INVITES_PAYPLUS_API_KEY=
INVITES_PAYPLUS_SECRET_KEY=
INVITES_PAYPLUS_PAGE_UID=
# "true" = PayPlus's sandbox.
INVITES_PAYPLUS_SANDBOX=false
# Monthly prices in shekels, VAT included (defaults 49 and 149).
INVITES_PRICE_PRO=
INVITES_PRICE_BUSINESS=
# Local and end-to-end tests only: a fake checkout page instead of PayPlus. NEVER in production.
INVITES_BILLING_TEST_MODE=false

# ── Partners: Badook Events opens users here — docs/partner-api.md ─────────────
# Bearer key of /api/partner/v1/…; random, ≥32 chars, shared only with Badook Events' server. Empty = off.
INVITES_PARTNER_API_KEY=

# ── Event planning: tasks, budget, vendors, ideas — docs/features.md ───────────
# The planning tab stays hidden until this is on: apply the planning migrations
# (supabase/migrations/*_planning_*.sql) to the database first. Its AI tools (a plan drafted from a
# description) also need the AI model above; INVITES_PLANNING_AI_DAILY_LIMIT, above, caps them.
INVITES_PLANNING=false

# ── Legal pages: the operator's details (each line shows only when set) ────────
INVITES_LEGAL_NAME=
INVITES_LEGAL_ID=
INVITES_LEGAL_ADDRESS=
INVITES_LEGAL_PHONE=
INVITES_ACCESSIBILITY_COORDINATOR=
INVITES_ACCESSIBILITY_PHONE=
INVITES_ACCESSIBILITY_EMAIL=
